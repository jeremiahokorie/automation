<body class="pc-font-alt" style="width: 100% !important;min-height: 100% !important;margin: 0 !important;padding: 0 !important;font-family: 'Fira Sans', Helvetica, Arial, sans-serif;line-height: 1.5;color: #2D3A41;mso-line-height-rule: exactly;-webkit-font-smoothing: antialiased;-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;font-variant-ligatures: none;text-rendering: optimizeLegibility;-moz-osx-font-smoothing: grayscale;background-color: #f4f4f4;">
<table class="pc-project-body" style="table-layout: fixed; min-width: 600px;" width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation">
    <tr>
        <td align="center" valign="top" bgcolor="#f4f4f4">
            <table class="pc-project-container" style="width: 600px; max-width: 600px;" width="600" align="center" border="0" cellpadding="0" cellspacing="0" role="presentation">
                <tr>
                    <td style="padding: 0px;" align="left" valign="top">
                        <!-- Official State Banner Header with Bauchi State Logo -->
                        <table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation">
                            <tr>
                                <td style="padding: 0px;">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation">
                                        <tr>
                                            <td valign="top" style="background-color: #003366; padding: 20px 40px; border-bottom: 5px solid #FFCC00;">
                                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                                    <tr>
                                                        <td width="80" valign="middle">
                                                            <!-- Bauchi State Logo -->
                                                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/5c/Coat_of_arms_of_Bauchi_State.png/1200px-Coat_of_arms_of_Bauchi_State.png" alt="Bauchi State Logo" width="80" height="80" style="display: block; border: none;">
                                                        </td>
                                                        <td valign="middle" style="padding-left: 20px;">
                                                            <table class="text-block" border="0" cellpadding="0" role="presentation" width="100%">
                                                                <tr>
                                                                    <td valign="top" class="text-block-td pc-font-alt" style="mso-line-height: exactly;line-height: 1.2;font-family: 'Georgia', serif;font-size: 24px;font-weight: bold;color: #FFFFFF;text-align: left;">
                                                                        BAUCHI STATE GOVERNMENT<br>
                                                                        <span style="font-size: 18px; font-weight: normal;">MINISTRY OF DEVELOPMENT AFFAIRS</span>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Welcome Content -->
                        <table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation" style="background-color: #FFFFFF;">
                            <tr>
                                <td style="padding: 40px 40px 20px 40px;">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                        <tr>
